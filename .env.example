# REPLACE THIS WITH YOUR ACTUAL POSTGRES DATABASE URL
DATABASE_URL="postgresql://user:password@localhost:5432/shop_anniversary?schema=public"

# Set to true for internal members (shows post-event prices by default and toggle in cart)
# Set to false for public (shows event prices only, no toggle)
INTERNAL=true

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_SECURE=false
SMTP_FROM='"Shop Anniversary" <noreply@eagletrt.it>'
